# =============================================================
# VANNYS TOUCH — BACKEND ENVIRONMENT VARIABLES (MODÈLE)
# Copier en .env et remplir. Ce fichier est versionné :
# il ne doit contenir QUE des espaces réservés, jamais une vraie valeur.
# =============================================================

NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# URL du frontend — sert au CORS et aux liens des emails (sans slash final)
FRONTEND_URL=http://localhost:5173

# ── Base de données ──────────────────────────────────────────
# MySQL 8 en local, TiDB Cloud en production (compatible MySQL)
DATABASE_URL=mysql://utilisateur:motdepasse@localhost:3306/vannys_base

# ── Authentification ─────────────────────────────────────────
# Générer avec : openssl rand -base64 64 — deux secrets DIFFÉRENTS
JWT_SECRET=remplacer-par-un-secret-genere
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=remplacer-par-un-autre-secret-genere
JWT_REFRESH_EXPIRES_IN=7d

# ── Cloudinary (images produits) ─────────────────────────────
CLOUDINARY_CLOUD_NAME=votre-cloud
CLOUDINARY_API_KEY=votre-cle
CLOUDINARY_API_SECRET=votre-secret
CLOUDINARY_FOLDER=vannys-touch/products

# ── Resend (emails transactionnels) ──────────────────────────
RESEND_API_KEY=re_votre_cle
MAIL_FROM_NAME=Vannys Touch
MAIL_FROM_ADDRESS=noreply@votre-domaine.com
MAIL_ADMIN_ADDRESS=admin@votre-domaine.com

# ── Livraison ────────────────────────────────────────────────
# Valeurs initiales ; le lot L6 les déplacera dans la table `settings`
FREE_SHIPPING_THRESHOLD=50000
SHIPPING_FEE=2500

# ── Notifications push (FACULTATIF) ──────────────────────────
# Sans ces trois valeurs, le push web se désactive proprement : les
# notifications restent consultables dans l'application.
# Générer une paire de clés : npx web-push generate-vapid-keys
# VAPID_SUBJECT doit commencer par « mailto: » ou « https:// ».
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@votre-domaine.com
