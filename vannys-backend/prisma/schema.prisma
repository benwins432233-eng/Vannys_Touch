// ============================================================
// VANNYS TOUCH - Prisma Schema
// ============================================================

generator client {
  provider      = "prisma-client-js"
  // binaryTargets couvre : local (native), Render (debian-openssl-3.0.x),
  // Docker Alpine (linux-musl-openssl-3.0.x), et CI/CD Linux générique
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum VariantType {
  COLOR
  SIZE
}

// ─── MODELS ─────────────────────────────────────────────────

model User {
  id              String    @id @default(uuid())
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  email           String    @unique @db.VarChar(255)
  password        String
  phone           String?   @db.VarChar(30)
  role            Role      @default(USER)
  avatarUrl       String?   @map("avatar_url")
  isActive        Boolean   @default(true) @map("is_active")
  refreshToken    String?   @map("refresh_token")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  orders          Order[]
  reviews         Review[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  imageUrl    String?   @map("image_url")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  products    Product[]

  @@map("categories")
}

model Product {
  id            String          @id @default(uuid())
  categoryId    String          @map("category_id")
  name          String          @db.VarChar(255)
  slug          String          @unique @db.VarChar(255)
  description   String?         @db.Text
  price         Decimal         @db.Decimal(12, 2)
  originalPrice Decimal?        @map("original_price") @db.Decimal(12, 2)
  badge         String?         @db.VarChar(50)
  rating        Decimal         @default(0) @db.Decimal(3, 1)
  reviewsCount  Int             @default(0) @map("reviews_count")
  inStock       Boolean         @default(true) @map("in_stock")
  isFeatured    Boolean         @default(false) @map("is_featured")
  isActive      Boolean         @default(true) @map("is_active")
  sortOrder     Int             @default(0) @map("sort_order")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  category      Category        @relation(fields: [categoryId], references: [id])
  images        ProductImage[]
  variants      ProductVariant[]
  orderItems    OrderItem[]
  reviews       Review[]

  @@index([categoryId])
  @@index([slug])
  @@index([isActive])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  cloudinaryId String   @map("cloudinary_id") @db.VarChar(255)
  url          String
  urlThumbnail String?  @map("url_thumbnail")
  urlMedium    String?  @map("url_medium")
  isPrimary    Boolean  @default(false) @map("is_primary")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVariant {
  id        String      @id @default(uuid())
  productId String      @map("product_id")
  type      VariantType
  value     String      @db.VarChar(100)
  createdAt DateTime    @default(now()) @map("created_at")

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_variants")
}

model Order {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  reference         String      @unique @db.VarChar(30)
  status            OrderStatus @default(PENDING)
  notes             String?     @db.Text
  subtotal          Decimal     @db.Decimal(12, 2)
  shippingFee       Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  total             Decimal     @db.Decimal(12, 2)
  trackingNumber    String?     @map("tracking_number") @db.VarChar(100)

  deliveryFullName  String      @map("delivery_full_name") @db.VarChar(100)
  deliveryPhone     String      @map("delivery_phone") @db.VarChar(30)
  deliveryCity      String      @map("delivery_city") @db.VarChar(100)
  deliveryDistrict  String      @map("delivery_district") @db.VarChar(100)
  deliveryAddress   String      @map("delivery_address") @db.Text
  deliveryLandmark  String?     @map("delivery_landmark") @db.VarChar(255)

  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  user              User        @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([reference])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productId       String?  @map("product_id")
  productName     String   @map("product_name") @db.VarChar(255)
  productImageUrl String?  @map("product_image_url")
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity        Int
  subtotal        Decimal  @db.Decimal(12, 2)
  variantColor    String?  @map("variant_color") @db.VarChar(50)
  variantSize     String?  @map("variant_size") @db.VarChar(50)

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Review {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  userId    String   @map("user_id")
  rating    Int
  comment   String?  @db.Text
  isVisible Boolean  @default(true) @map("is_visible")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id])

  @@unique([productId, userId])
  @@index([productId])
  @@map("reviews")
}
