generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  firstName         String     @map("first_name") @db.VarChar(100)
  lastName          String     @map("last_name") @db.VarChar(100)
  email             String     @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime?  @db.Timestamp(0)
  password          String     @db.VarChar(255)
  phone             String?    @db.VarChar(30)
  role              users_role @default(user)
  avatarUrl         String?    @map("avatar_url") @db.VarChar(500)
  isActive          Boolean    @default(true) @map("is_active")
  remember_token    String?    @db.VarChar(100)
  createdAt         DateTime?  @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime?  @updatedAt @map("updated_at") @db.Timestamp(0)
  orders            Order[]
  reviews           Review[]
  refreshToken  String?  @map("refresh_token") @db.VarChar(255)

  @@index([email], map: "users_email_index")
  @@index([role], map: "users_role_index")
  @@map("users")
}

model Category {
  id          BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  name        String    @db.VarChar(100)
  slug        String    @unique(map: "categories_slug_unique") @db.VarChar(100)
  icon        String    @default("tag") @db.VarChar(50)
  description String?   @db.Text
  color       String    @default("#2196F3") @db.VarChar(7)
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  products    Product[]

  @@index([isActive], map: "categories_is_active_index")
  @@index([slug], map: "categories_slug_index")
  @@map("categories")
}

model Product {
  id            BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId    BigInt           @map("category_id") @db.UnsignedBigInt
  name          String           @db.VarChar(255)
  slug          String           @unique(map: "products_slug_unique") @db.VarChar(255)
  description   String?          @db.Text
  price         Decimal          @db.Decimal(12, 2)
  originalPrice Decimal?         @map("original_price") @db.Decimal(12, 2)
  badge         String?          @db.VarChar(50)
  rating        Decimal          @default(0.0) @db.Decimal(2, 1)
  reviewsCount  Int              @default(0) @map("reviews_count") @db.UnsignedInt
  /// Référence lisible par l'équipe (PRD-00042), stable dans le temps.
  reference     String           @unique(map: "products_reference_unique") @db.VarChar(30)
  /// En dessous de ce total de stock, le produit est signalé en « stock faible ».
  lowStockThreshold Int          @default(3) @map("low_stock_threshold") @db.UnsignedSmallInt
  isFeatured    Boolean          @default(false) @map("is_featured")
  isActive      Boolean          @default(true) @map("is_active")
  sortOrder     Int              @default(0) @map("sort_order") @db.SmallInt
  createdAt     DateTime?        @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime?        @updatedAt @map("updated_at") @db.Timestamp(0)
  orderItems    OrderItem[]
  images        ProductImage[]
  variants      ProductVariant[]
  category      Category         @relation(fields: [categoryId], references: [id], onUpdate: NoAction, map: "products_category_id_foreign")
  reviews       Review[]

  @@index([categoryId], map: "products_category_id_index")
  @@index([isActive], map: "products_is_active_index")
  @@index([isFeatured], map: "products_is_featured_index")
  @@index([price], map: "products_price_index")
  @@index([slug], map: "products_slug_index")
  @@map("products")
}

model ProductImage {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  productId    BigInt   @map("product_id") @db.UnsignedBigInt
  cloudinaryId String   @map("cloudinary_id") @db.VarChar(255)
  url          String   @db.VarChar(500)
  urlThumbnail String?  @map("url_thumbnail") @db.VarChar(500)
  urlMedium    String?  @map("url_medium") @db.VarChar(500)
  alt_text     String?  @db.VarChar(255)
  isPrimary    Boolean  @default(false) @map("is_primary")
  sortOrder    Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_images_product_id_foreign")

  @@index([productId], map: "product_images_product_id_foreign")
  @@map("product_images")
}

/// Combinaison vendable d'un produit : c'est elle qui porte le stock.
/// `size` et `color` sont nuls quand le produit ne se décline pas sur cet axe.
model ProductVariant {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt    @map("product_id") @db.UnsignedBigInt
  size      String?   @db.VarChar(50)
  color     String?   @db.VarChar(50)
  stock     Int       @default(0) @db.UnsignedInt
  sku       String?   @unique(map: "product_variants_sku_unique") @db.VarChar(60)
  /// Une variante déjà commandée n'est jamais supprimée : elle est désactivée,
  /// pour que l'historique des commandes reste exact.
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "product_variants_product_id_foreign")

  @@unique([productId, size, color], map: "product_variants_product_size_color_unique")
  @@index([productId], map: "product_variants_product_id_index")
  @@map("product_variants")
}

model Order {
  id               BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt                @map("user_id") @db.UnsignedBigInt
  reference        String                @unique(map: "orders_reference_unique") @db.VarChar(30)
  status           orders_status         @default(pending)
  payment_method   orders_payment_method
  phone_number     String                @db.VarChar(30)
  deliveryFullName String?               @map("delivery_full_name") @db.VarChar(100)
  deliveryPhone    String?               @map("delivery_phone") @db.VarChar(30)
  deliveryCity     String?               @map("delivery_city") @db.VarChar(100)
  deliveryDistrict String?               @map("delivery_district") @db.VarChar(100)
  deliveryAddress  String?               @map("delivery_address") @db.Text
  deliveryLandmark String?               @map("delivery_landmark") @db.VarChar(255)
  subtotal         Decimal               @db.Decimal(12, 2)
  shippingFee      Decimal               @default(0.00) @map("shipping_fee") @db.Decimal(12, 2)
  total            Decimal               @db.Decimal(12, 2)
  total_amount     Decimal?              @db.Decimal(12, 2)
  notes            String?               @db.Text
  payment_ref      String?               @db.VarChar(255)
  payment_status   orders_payment_status @default(unpaid)
  trackingNumber   String?               @map("tracking_number") @db.VarChar(255)
  createdAt        DateTime?             @map("created_at") @db.Timestamp(0)
  updatedAt        DateTime?             @updatedAt @map("updated_at") @db.Timestamp(0)
  items            OrderItem[]
  user             User                  @relation(fields: [userId], references: [id], onUpdate: NoAction, map: "orders_user_id_foreign")
  payments         payments[]

  @@index([createdAt], map: "orders_created_at_index")
  @@index([reference], map: "orders_reference_index")
  @@index([status], map: "orders_status_index")
  @@index([userId], map: "orders_user_id_index")
  @@map("orders")
}

model OrderItem {
  id              BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  orderId         BigInt   @map("order_id") @db.UnsignedBigInt
  productId       BigInt   @map("product_id") @db.UnsignedBigInt
  productName     String   @map("product_name") @db.VarChar(255)
  productImageUrl String?  @map("product_image_url") @db.VarChar(500)
  unitPrice       Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity        Int      @default(1) @db.UnsignedInt
  subtotal        Decimal  @db.Decimal(12, 2)
  variantColor    String?  @map("variant_color") @db.VarChar(50)
  variantSize     String?  @map("variant_size") @db.VarChar(50)
  created_at      DateTime @default(now()) @db.Timestamp(0)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "order_items_order_id_foreign")
  product         Product  @relation(fields: [productId], references: [id], onUpdate: NoAction, map: "order_items_product_id_foreign")

  @@index([orderId], map: "order_items_order_id_index")
  @@index([productId], map: "order_items_product_id_index")
  @@map("order_items")
}

model Review {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  productId BigInt    @map("product_id") @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  rating    Int       @db.UnsignedTinyInt
  comment   String?   @db.Text
  isVisible Boolean   @default(true) @map("is_visible")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamp(0)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reviews_product_id_foreign")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reviews_user_id_foreign")

  @@unique([userId, productId], map: "reviews_user_id_product_id_unique")
  @@index([productId], map: "reviews_product_id_index")
  @@index([rating], map: "reviews_rating_index")
  @@map("reviews")
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model payments {
  id             BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  order_id       BigInt          @db.UnsignedBigInt
  payment_ref    String          @unique(map: "payments_payment_ref_unique") @db.VarChar(255)
  talypay_ref    String?         @db.VarChar(255)
  amount         Decimal         @db.Decimal(12, 2)
  payment_method String          @db.VarChar(255)
  payment_mode   String          @db.VarChar(255)
  status         payments_status @default(pending)
  phone_number   String          @db.VarChar(255)
  talypay_data   Json?
  created_at     DateTime?       @db.Timestamp(0)
  updated_at     DateTime?       @db.Timestamp(0)
  orders         Order           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_order_id_foreign")

  @@index([order_id], map: "payments_order_id_foreign")
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.Text
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([expires_at], map: "personal_access_tokens_expires_at_index")
  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

enum orders_status {
  pending
  processing
  delivered
  cancelled
}

enum orders_payment_method {
  MTN
  MOOV
  ORANGE
  CELTIIS
}

enum payments_status {
  pending
  paid
  failed
  cancelled
}

enum users_role {
  user
  admin
}

enum orders_payment_status {
  unpaid
  pending
  paid
  failed
}

